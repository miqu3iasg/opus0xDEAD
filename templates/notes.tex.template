% This is a general-purpose template for converting study notes (originally
% written in Markdown or coding files) into a LaTeX document, for any book.
%
% Conversion instructions:
%
% - The notes may be written in English or in Portuguese, depending on the
%   book. When converting Markdown notes into this LaTeX file, keep the
%   original language of the notes exactly as written.
% - Do not alter, rephrase, or translate the content of the notes. Only
%   format it appropriately for LaTeX (sections, code blocks, emphasis,
%   lists, etc.).
% - Code comments are part of the notes and must also be kept in their
%   original language.
% - The entire visible document must match the language of the notes'
%   content, not just the notes themselves. This includes the header and
%   footer text, section titles such as "References", the subtitle
%   "Personal study notes", and any other fixed label produced by this
%   template. If the notes are in Portuguese, every visible piece of text
%   in the document must be in Portuguese; if the notes are in English,
%   every visible piece of text must be in English. These fixed labels
%   are marked below with a comment so they can be translated as a group.
%
% Usage:
%
% 1. Copy this file to start a new book's notes.
% 2. Fill in the fields marked with <...> in the "document variables"
%    section below. That is the only place you need to edit to configure
%    the whole document.
% 3. If the book is not about programming, the listings package and the
%    code block section can be removed.
% 4. Duplicate the section block for each chapter of notes.

\documentclass[12pt,a4paper]{article}

% Encoding and language
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[brazilian]{babel}
\usepackage{lmodern}

% Page layout
\usepackage{geometry}
\geometry{margin=2.5cm}
\usepackage{setspace}
\onehalfspacing

% Document variables
% Fill these in for each new book.
\newcommand{\bookTitle}{<BOOK TITLE>}
\newcommand{\bookShortTitle}{<SHORT TITLE OR ACRONYM>} % used in the page header
\newcommand{\bookAuthor}{<BOOK AUTHOR(S)>}
\newcommand{\studentName}{Miquéias Alves Medeiros}
\newcommand{\documentSubject}{Study notes on \bookTitle}
\newcommand{\documentKeywords}{<KEYWORD1, KEYWORD2, KEYWORD3>}

% Full bibliographic reference
\newcommand{\fullReference}{%
	<LAST NAME>, <First name>. \textit{\bookTitle}. <edition>. <City>: <Publisher>, <year>.%
}

% Headers and footers
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\bookShortTitle\ --- Personal notes} % fixed label: translate to match notes' language
\fancyhead[R]{\studentName}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

% Code listings (remove this block if the book does not involve code)
\usepackage{listings}
\usepackage{xcolor}

% Replace "Scheme" with the language relevant to this book, or remove
% this custom definition and use \lstset{language=...} directly with a
% language already supported by listings (Python, C, Java, etc.)
\lstdefinelanguage{Scheme}{
	morekeywords={},
	sensitive=true,
	morecomment=[l]{;},
}

\lstset{
	language=Scheme,
	basicstyle=\ttfamily\small,
	commentstyle=\color{gray},
	breaklines=true,
	showstringspaces=false,
	frame=none,
	columns=fullflexible,
	numbers=left,
	numberstyle=\tiny\color{gray},
	numbersep=8pt,
	captionpos=b,
}

% Hyperlinks and PDF metadata
\usepackage{hyperref}
\hypersetup{
	pdftitle={\bookTitle\ - Personal notes},
	pdfauthor={\studentName},
	pdfsubject={\documentSubject},
	pdfkeywords={\documentKeywords},
	colorlinks=true,
	linkcolor=black,
	citecolor=blue,
	urlcolor=blue,
}

% Title page
\title{\bookTitle \\ \large Personal study notes} % fixed label: translate to match notes' language
\author{\studentName}
\date{\today}

\begin{document}

\maketitle
\thispagestyle{empty}

\begin{center}
	\small Notes based on the work by \bookAuthor. % fixed label: translate to match notes' language
\end{center}

\vfill

\tableofcontents

\newpage

% Content
% Duplicate the block below for each chapter.
\section{Notes on ch. <NUMBER> <CHAPTER TITLE>, pp. <XX-XX>} % fixed label: translate to match notes' language

Introductory or explanatory text goes here.

% Remove this block if not applicable to the book
\begin{lstlisting}[caption={<Example description>}]
<example code here>
\end{lstlisting}

More explanatory text.

% Copy the \section above (and \newpage before it, if chapters should
% start on separate pages) to add more chapters.

\newpage
\section*{References} % fixed label: translate to match notes' language
\addcontentsline{toc}{section}{References} % fixed label: translate to match notes' language

\begin{thebibliography}{9}

	\bibitem{reference1}
	\fullReference

\end{thebibliography}

\end{document}
